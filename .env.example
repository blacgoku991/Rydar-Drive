# =============================================================================
# Rydar Drive — variables d'environnement
# Copiez vers apps/web/.env.local et apps/worker/.env
# =============================================================================

# --- Supabase ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # clé publique (anon / publishable)
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # SERVEUR UNIQUEMENT — jamais exposée au navigateur
# Connexion PostgreSQL directe (worker : LISTEN/NOTIFY → port 5432, pas le pooler transactionnel)
DATABASE_URL=postgresql://postgres:password@db.xxxxxxxx.supabase.co:5432/postgres

# --- Application web ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://app.rydar.app
NEXT_PUBLIC_ROOT_DOMAIN=rydar.app                # mini-sites : {slug}.rydar.app
# Poivre HMAC des clés API (32+ caractères aléatoires). Changer = invalider toutes les clés.
API_KEY_PEPPER=change-me-with-a-long-random-secret
# Rate limiting / anti brute force partagé entre instances
REDIS_URL=redis://localhost:6379

# --- Cartographie, adresses, itinéraires ------------------------------------------
# Tuiles vectorielles (schéma OpenMapTiles) + polices — défaut : OpenFreeMap (gratuit, sans clé)
NEXT_PUBLIC_MAP_TILES_URL=https://tiles.openfreemap.org/planet
NEXT_PUBLIC_MAP_GLYPHS_URL=https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf
# Style complet tiers (optionnel, remplace le style Rydar) : MapTiler, Mapbox…
NEXT_PUBLIC_MAP_STYLE_URL=
# Géocodage : geopf (IGN, gratuit, France) | ban | google | mapbox ; GEOCODER_URL = serveur compatible BAN
GEOCODER_PROVIDER=geopf
GEOCODER_URL=
# Itinéraires : osrm | mapbox | google | none — OSRM auto-hébergé recommandé (voir docs/DEPLOYMENT.md)
ROUTING_PROVIDER=osrm
OSRM_URL=https://router.project-osrm.org
GOOGLE_MAPS_API_KEY=
MAPBOX_TOKEN=
# Aperçu web de l'app chauffeur autorisé à se connecter (CORS), ex. http://localhost:8081
DRIVER_APP_ORIGINS=

# --- Stripe (abonnements SaaS) -------------------------------------------------
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Notifications push (worker) -------------------------------------------------
# Expo Push (recommandé, gère FCM + APNs) — jeton d'accès optionnel
EXPO_ACCESS_TOKEN=
# Envoi direct FCM (Android) : JSON du compte de service Firebase (base64)
FCM_SERVICE_ACCOUNT_B64=
# Envoi direct APNs (iOS) : clé .p8 (base64), key id, team id, bundle id
APNS_KEY_P8_B64=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=app.rydar.driver
APNS_PRODUCTION=true
