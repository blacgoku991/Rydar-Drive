{
  "name": "@rydar/driver",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "export:check": "expo export --platform android --output-dir .expo-export-check",
    "web": "node scripts/copy-maplibre.mjs && expo start --web",
    "export:web": "node scripts/copy-maplibre.mjs && expo export --platform web --output-dir dist-web"
  },
