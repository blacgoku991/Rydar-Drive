    "aes-js": "^3.1.2",
    "expo": "~57.0.25",
    "expo-application": "~57.0.3",
    "expo-audio": "~57.0.5",
    "expo-battery": "~57.0.3",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-device": "~57.0.2",
    "expo-haptics": "~57.0.3",
    "expo-keep-awake": "~57.0.2",
    "expo-linear-gradient": "~57.0.2",
