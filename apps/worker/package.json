{
  "name": "@rydar/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "build": "tsup src/index.ts src/simulator.ts --format esm --target node20 --clean --no-splitting --noExternal @rydar/shared",
    "simulate": "tsx --env-file-if-exists=.env src/simulator.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rydar/shared": "workspace:*",
    "expo-server-sdk": "^7.2.0",
    "jose": "^6.2.12",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
