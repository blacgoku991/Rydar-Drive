# Configuration de production Rydar Drive (VPS). Copiée en deploy/.env par install.sh :
# complétez-la puis relancez « sudo bash deploy/install.sh ». Ne la versionnez jamais.
# Un commentaire par ligne (pas de commentaire en fin de valeur).

# ------------------------------------------------------------------ Domaine
# Site : https://DOMAIN ; mini-sites : https://{centrale}.DOMAIN (DNS : enregistrements A pour @, www et *)
DOMAIN=
# E-mail de contact pour les certificats HTTPS (Let's Encrypt)
ACME_EMAIL=

# ------------------------------------------------------------------ Supabase (projet cloud, région Europe)
# Project Settings → API Keys. URL : https://xxxx.supabase.co
# Sert aussi au worker (SUPABASE_URL) : reprise des suppressions de compte chauffeur (fichiers, compte de connexion)
NEXT_PUBLIC_SUPABASE_URL=
# Clé publishable (sb_publishable_…) ou, onglet Legacy, clé anon
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé secret (sb_secret_…) ou, onglet Legacy, clé service_role : ne jamais la diffuser
# Site et worker (le worker s'en sert pour reprendre les suppressions de compte chauffeur : fichiers, compte de connexion)
SUPABASE_SERVICE_ROLE_KEY=
# Connect → « Session pooler » (port 5432 ; pas le pooler transactionnel 6543), terminée par ?sslmode=no-verify
# ex. postgresql://postgres.abcd1234:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres?sslmode=no-verify
# deploy/configure.sh y insère le mot de passe (encodé) ; à la main, encodez ses caractères spéciaux (@ → %40, $ → %24…)
DATABASE_URL=
# Supabase auto-hébergé sur ce serveur : postgresql://postgres:MOT_DE_PASSE@127.0.0.1:5432/postgres (DATABASE_SSLMODE=disable)
# Chiffrement de la connexion (worker, migrations) ; remplace le sslmode de DATABASE_URL (vide = verify-full) :
# verify-full : certificat du serveur vérifié avec la racine publique Supabase (deploy/supabase-ca.crt)
# no-verify : ancien mode, chiffré SANS vérification, en repli seulement (docs/DEPLOYMENT.md, « Connexion chiffrée à la base »)
# disable : sans chiffrement, base locale seulement (localhost, 127.x, ::1, 10.x, 172.16-31.x, 192.168.x ou conteneur
# Docker sans point dans le nom) ; refusé pour une base distante
DATABASE_SSLMODE=verify-full

# ------------------------------------------------------------------ Sécurité
# Poivre des clés API (généré par install.sh) : ne jamais le changer ensuite (les clés seraient invalidées)
API_KEY_PEPPER=

# ------------------------------------------------------------------ Abonnements (Stripe) — optionnel au départ
STRIPE_SECRET_KEY=
# Webhook : https://DOMAIN/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# ------------------------------------------------------------------ Notifications push de l'app chauffeur
# Expo (le plus simple) : expo.dev → Access tokens. Recommandé en production : une fois un push reçu avec ce jeton,
# activez « Enhanced Security for Push Notifications » (même page) : sans elle, quiconque connaît le jeton push d'un
# téléphone peut lui envoyer une notification au nom de Rydar Drive (docs/DEPLOYMENT.md § 3)
EXPO_ACCESS_TOKEN=
# Ou envoi direct FCM / APNs (voir docs/DEPLOYMENT.md)
FCM_SERVICE_ACCOUNT_B64=
APNS_KEY_P8_B64=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
# APNs direct : false = serveur sandbox (builds de développement) ; vide = production
APNS_PRODUCTION=

# ------------------------------------------------------------------ WhatsApp (relances) — jetons en base, pas ici
# Version de l'API Graph de Meta (vide = version par défaut du code, voir docs/WHATSAPP.md)
WHATSAPP_API_VERSION=

# ------------------------------------------------------------------ Cartes, adresses, itinéraires
# Défauts gratuits : tuiles OpenFreeMap, adresses IGN (geopf), itinéraires OSRM
GEOCODER_PROVIDER=geopf
ROUTING_PROVIDER=osrm
# Serveur de démo public (limité) : passez à http://osrm:5000 après deploy/osrm-prepare.sh
OSRM_URL=https://router.project-osrm.org
MAPBOX_TOKEN=
GOOGLE_MAPS_API_KEY=
# Google / Mapbox : requêtes payantes par jour, adresses et itinéraires comptés à part (vide = 20000) ;
# au-delà, adresses IGN / BAN et distance estimée
GEO_DAILY_BUDGET=
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_MAP_TILES_URL=
NEXT_PUBLIC_MAP_GLYPHS_URL=
NEXT_PUBLIC_MAP_CONNECT_ORIGINS=

# ------------------------------------------------------------------ Suivi des vols (optionnel)
# aerodatabox | aviationstack | flightaware (sans clé : suivi désactivé en production)
FLIGHT_PROVIDER=
AERODATABOX_KEY=
AERODATABOX_MARKETPLACE=
AVIATIONSTACK_KEY=
FLIGHTAWARE_KEY=
# URL de base, heures aviationstack (local | utc) : vides = défauts (docs/DEPLOYMENT.md, « Suivi des vols »)
AERODATABOX_URL=
AVIATIONSTACK_URL=
AVIATIONSTACK_TIMES=
FLIGHTAWARE_URL=

# ------------------------------------------------------------------ Divers
# Origines web autorisées à appeler les routes de l'app chauffeur (/api/auth/driver-login, /api/auth/driver-password-reset…)
# depuis un navigateur : aperçu web de l'app, optionnel
DRIVER_APP_ORIGINS=

# ------------------------------------------------------------------ Application chauffeur
# Liens universels iOS (https://DOMAINE/rejoindre/{code} ouvre l'app) : « TEAMID.identifiant.bundle »
APPLE_APP_IDS=
# Lien d'installation proposé sur la page d'inscription (App Store ou lien public TestFlight)
IOS_APP_URL=
# Lien Google Play proposé sur la page d'inscription
ANDROID_APP_URL=
# Liens d'application Android (/.well-known/assetlinks.json) : empreinte SHA-256 du certificat de signature
# (Play Console › Intégrité de l'application › Signature d'application) ; paquet si différent de app.rydar.driver
ANDROID_CERT_SHA256=
ANDROID_APP_PACKAGE=

# ------------------------------------------------------------------ Éditeur (pages légales exigées par les stores)
# /confidentialite et /suppression-compte : société éditrice, e-mail de contact données personnelles, adresse
LEGAL_NAME=
LEGAL_EMAIL=
LEGAL_ADDRESS=

# ------------------------------------------------------------------ Formulaire de contact (/contact) et e-mails
# Destinataire des demandes (une adresse, ou plusieurs séparées par des virgules) ; vide = e-mail de /admin/legal,
# puis LEGAL_EMAIL. Les demandes arrivent aussi dans /admin/contacts.
CONTACT_NOTIFY_EMAIL=
# Expéditeur des e-mails (notification, accusé de réception, réponses) ; vide = « Rydar Drive <noreply@DOMAIN> »
MAIL_FROM=
# Serveur mail du VPS, joint par le service mailer (réseau de l'hôte) : Postfix en écoute locale sur le port 25.
# Relais externe (avancé, port 25 sortant bloqué) : SMTP_HOST, SMTP_PORT=587, SMTP_USER, SMTP_PASS (docs/DEPLOYMENT.md)
# SMTP_HOST=127.0.0.1
# SMTP_PORT=25
# SMTP_USER=
# SMTP_PASS=
