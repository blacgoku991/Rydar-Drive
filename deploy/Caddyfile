# Caddy : HTTPS automatique (Let's Encrypt) devant le site Rydar Drive.
# Variables : DOMAIN (ex. rydardrive.fr), ACME_EMAIL (contact Let's Encrypt).
{
	email {$ACME_EMAIL}
	# Mini-sites : certificat émis à la première visite, seulement pour un domaine connu
	on_demand_tls {
		ask http://web:3000/api/tls/allowed
	}
	# En-têtes lus en 10 s au plus (connexions « lentes » qui occupent le serveur sans rien envoyer). Aucun délai sur le
	# CORPS (read_body) : il s'appliquerait aussi aux envois de documents vers api.DOMAINE (Caddyfile.local, même
	# serveur) sur un réseau mobile lent
	servers {
		timeouts {
			read_header 10s
		}
	}
}

# Plateforme : dashboard, super admin, API v1, inscription des chauffeurs (/rejoindre/…)
{$DOMAIN} {
	encode zstd gzip
	# Tout corps de requête plafonné à 2 Mo (aucune route n'en reçoit plus : actions serveur 1 Mo, fichiers déposés
	# directement dans Supabase Storage) : sans plafond, Next garde jusqu'à 10 Mo par requête en mémoire (audit p5)
	request_body {
		max_size 2MB
	}
	# Réservé à Caddy (on_demand_tls, appel interne à web:3000) : jamais servi depuis Internet (lectures en base)
	@tls_ask path /api/tls/allowed
	respond @tls_ask 404
	# Webhook Stripe (quelques Ko, signature vérifiée après lecture) : corps plafonné avant l'application
	@stripe_webhook path /api/stripe/webhook
	request_body @stripe_webhook {
		max_size 1MB
	}
	# API v1 (clés des centrales) : JSON de quelques Ko (32 Ko lus au plus par l'application, lib/api/v1.ts) ; un
	# corps plus lourd est refusé (413) par Caddy, sans occuper le serveur Node
	@api_v1 path /api/v1/*
	request_body @api_v1 {
		max_size 1MB
	}
	reverse_proxy web:3000 {
		# IP réelle de la connexion (limitations de débit) ; un client ne choisit pas son IP par en-tête
		header_up X-Real-IP {remote_host}
		header_up -Cf-Connecting-Ip
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# Mini-sites de réservation : {centrale}.DOMAIN et domaines personnalisés des centrales
https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	# Mêmes plafond général et fermeture que pour le domaine
	request_body {
		max_size 2MB
	}
	@tls_ask path /api/tls/allowed
	respond @tls_ask 404
	# Mêmes plafonds ici : le webhook et l'API v1 répondent aussi derrière un hôte de mini-site
	@stripe_webhook path /api/stripe/webhook
	request_body @stripe_webhook {
		max_size 1MB
	}
	@api_v1 path /api/v1/*
	request_body @api_v1 {
		max_size 1MB
	}
	reverse_proxy web:3000 {
		# IP réelle de la connexion (limitations de débit) ; un client ne choisit pas son IP par en-tête
		header_up X-Real-IP {remote_host}
		header_up -Cf-Connecting-Ip
	}
}
