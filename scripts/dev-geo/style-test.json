{
  "version": 8,
  "name": "Rydar dev — style de test (toutes couches OpenMapTiles)",
  "glyphs": "http://localhost:3000/dev-map/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": { "type": "vector", "url": "http://localhost:3000/dev-map/tiles.json" }
  },
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#0b0d11" } },
    { "id": "landcover", "type": "fill", "source": "openmaptiles", "source-layer": "landcover",
      "paint": { "fill-color": ["match", ["get", "class"], "wood", "#10241a", "grass", "#12211a", "farmland", "#1a1d14", "sand", "#2a2618", "wetland", "#10222a", "rock", "#1e1f22", "#141814"], "fill-opacity": 0.9 } },
    { "id": "landuse", "type": "fill", "source": "openmaptiles", "source-layer": "landuse",
      "paint": { "fill-color": ["match", ["get", "class"], "residential", "#12151b", "industrial", "#1a1720", "commercial", "#1b161a", "retail", "#1d161a", "cemetery", "#15201a", "hospital", "#261419", "school", "#221d12", "university", "#221d12", "college", "#221d12", "kindergarten", "#221d12", "stadium", "#132218", "pitch", "#132a1c", "railway", "#1a1a1f", "#16181d"] } },
    { "id": "park", "type": "fill", "source": "openmaptiles", "source-layer": "park", "filter": ["==", ["geometry-type"], "Polygon"],
      "paint": { "fill-color": "#14301f", "fill-outline-color": "#1f4a2e" } },
    { "id": "water", "type": "fill", "source": "openmaptiles", "source-layer": "water",
      "paint": { "fill-color": ["match", ["get", "class"], "ocean", "#0b2238", "river", "#0e2a45", "lake", "#0e2a45", "pond", "#10304d", "swimming_pool", "#1b4f72", "#0e2a45"] } },
    { "id": "waterway", "type": "line", "source": "openmaptiles", "source-layer": "waterway",
      "paint": { "line-color": "#15406a", "line-width": ["match", ["get", "class"], "river", 2.2, "canal", 1.6, 0.8] } },
    { "id": "aeroway-area", "type": "fill", "source": "openmaptiles", "source-layer": "aeroway", "filter": ["==", ["geometry-type"], "Polygon"],
      "paint": { "fill-color": ["match", ["get", "class"], "aerodrome", "#161a24", "apron", "#20242e", "#22262f"], "fill-opacity": 0.9 } },
    { "id": "aeroway-line", "type": "line", "source": "openmaptiles", "source-layer": "aeroway", "filter": ["==", ["geometry-type"], "LineString"],
      "paint": { "line-color": "#3a4150", "line-width": ["interpolate", ["exponential", 1.6], ["zoom"], 10, ["match", ["get", "class"], "runway", 2, 0.5], 15, ["match", ["get", "class"], "runway", 40, 8]] } },
    { "id": "building", "type": "fill", "source": "openmaptiles", "source-layer": "building", "minzoom": 14,
      "paint": { "fill-color": "#1c212b", "fill-outline-color": "#262d3a" } },
    { "id": "road-tunnel", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "filter": ["==", ["get", "brunnel"], "tunnel"],
      "paint": { "line-color": "#39404d", "line-dasharray": [2, 2], "line-width": 1.2 } },
    { "id": "rail", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["all", ["in", ["get", "class"], ["literal", ["rail", "transit"]]], ["!=", ["get", "brunnel"], "tunnel"]],
      "paint": { "line-color": "#4b5263", "line-width": 1.1, "line-dasharray": [3, 2] } },
    { "id": "path", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "filter": ["in", ["get", "class"], ["literal", ["path", "track"]]],
      "paint": { "line-color": "#2d3340", "line-width": 0.8, "line-dasharray": [1.5, 1.5] } },
    { "id": "road-casing", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["all", ["in", ["get", "class"], ["literal", ["motorway", "trunk", "primary", "secondary", "tertiary", "minor", "service"]]], ["!=", ["get", "brunnel"], "tunnel"]],
      "layout": { "line-join": "round", "line-cap": "round" },
      "paint": { "line-color": ["case", ["==", ["get", "brunnel"], "bridge"], "#8b93a1", "#07080b"],
                 "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 5, 0.5, 10, ["match", ["get", "class"], ["motorway", "trunk"], 3, "primary", 2.4, 1.2], 15, ["match", ["get", "class"], ["motorway", "trunk"], 16, "primary", 13, ["secondary", "tertiary"], 11, "minor", 8, 5]] } },
    { "id": "road", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["all", ["in", ["get", "class"], ["literal", ["motorway", "trunk", "primary", "secondary", "tertiary", "minor", "service"]]], ["!=", ["get", "brunnel"], "tunnel"]],
      "layout": { "line-join": "round", "line-cap": "round" },
      "paint": { "line-color": ["match", ["get", "class"], "motorway", "#c7f36b", "trunk", "#a9d85a", "primary", "#5b6478", "secondary", "#4a5263", "tertiary", "#414859", "#323846"],
                 "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 5, 0.3, 10, ["match", ["get", "class"], ["motorway", "trunk"], 2, "primary", 1.6, 0.7], 15, ["match", ["get", "class"], ["motorway", "trunk"], 13, "primary", 10, ["secondary", "tertiary"], 8.5, "minor", 6, 3.5]] } },
    { "id": "oneway", "type": "symbol", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 15, "filter": ["==", ["get", "oneway"], 1],
      "layout": { "symbol-placement": "line", "symbol-spacing": 120, "text-field": "›", "text-font": ["Noto Sans Regular"], "text-size": 14, "text-keep-upright": false },
      "paint": { "text-color": "#8b93a1" } },
    { "id": "water-name", "type": "symbol", "source": "openmaptiles", "source-layer": "water_name",
      "layout": { "text-field": ["get", "name"], "text-font": ["Noto Sans Italic"], "text-size": 13 }, "paint": { "text-color": "#4c7fb0" } },
    { "id": "waterway-name", "type": "symbol", "source": "openmaptiles", "source-layer": "waterway", "minzoom": 12,
      "layout": { "symbol-placement": "line", "text-field": ["get", "name"], "text-font": ["Noto Sans Italic"], "text-size": 12 }, "paint": { "text-color": "#4c7fb0" } },
    { "id": "road-name", "type": "symbol", "source": "openmaptiles", "source-layer": "transportation_name",
      "layout": { "symbol-placement": "line", "text-field": ["coalesce", ["get", "name"], ["get", "ref"]], "text-font": ["Noto Sans Regular"], "text-size": ["interpolate", ["linear"], ["zoom"], 11, 10, 15, 13] },
      "paint": { "text-color": "#b6bdc9", "text-halo-color": "#07080b", "text-halo-width": 1.5 } },
    { "id": "park-name", "type": "symbol", "source": "openmaptiles", "source-layer": "park", "filter": ["==", ["geometry-type"], "Point"],
      "layout": { "text-field": ["get", "name"], "text-font": ["Noto Sans Italic"], "text-size": 11 }, "paint": { "text-color": "#5fa877", "text-halo-color": "#07080b", "text-halo-width": 1 } },
    { "id": "poi", "type": "symbol", "source": "openmaptiles", "source-layer": "poi",
      "layout": { "text-field": ["get", "name"], "text-font": ["Noto Sans Medium"], "text-size": 11, "text-max-width": 8 },
      "paint": { "text-color": ["match", ["get", "class"], "railway", "#4C9DFF", "aerodrome", "#FFB020", "#d7a8ff"], "text-halo-color": "#07080b", "text-halo-width": 1.2 } },
    { "id": "aerodrome-label", "type": "symbol", "source": "openmaptiles", "source-layer": "aerodrome_label",
      "layout": { "text-field": ["concat", ["get", "name"], "\n", ["coalesce", ["get", "iata"], ""]], "text-font": ["Noto Sans Medium"], "text-size": 12 },
      "paint": { "text-color": "#FFB020", "text-halo-color": "#07080b", "text-halo-width": 1.5 } },
    { "id": "place", "type": "symbol", "source": "openmaptiles", "source-layer": "place",
      "layout": { "text-field": ["get", "name"], "text-font": ["match", ["get", "class"], ["city", "town"], ["literal", ["Noto Sans Medium"]], ["literal", ["Noto Sans Regular"]]],
                  "text-size": ["match", ["get", "class"], "city", 16, "town", 13, "village", 12, "suburb", 12, 11], "symbol-sort-key": ["get", "rank"],
                  "text-transform": ["match", ["get", "class"], ["suburb", "quarter"], "uppercase", "none"], "text-letter-spacing": ["match", ["get", "class"], ["suburb", "quarter"], 0.08, 0] },
      "paint": { "text-color": ["match", ["get", "class"], "city", "#F4F5F7", "town", "#dfe3ea", "#9aa3b2"], "text-halo-color": "#07080b", "text-halo-width": 1.6 } }
  ]
}
